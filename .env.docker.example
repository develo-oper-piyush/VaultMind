# ==============================================================================
# 🌌 VaultMind Docker Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: cp .env.docker.example .env
# 2. Fill in your Supabase credentials, MongoDB URI, and Gemini API key.
# 3. Start the containers: docker compose up --build -d
# ==============================================================================

# ==========================================
# Server & Network URLs
# ==========================================
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ==========================================
# MongoDB Database Connection
# ==========================================
# Remote MongoDB Atlas connection:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/drive-db
# OR if using local Docker MongoDB (--profile local-db):
# MONGODB_URI=mongodb://mongodb:27017/drive-db

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=your_jwt_secret_key_change_in_production

# ==========================================
# Supabase Cloud Storage
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=Files-upload

# ==========================================
# Google Gemini AI SDK
# ==========================================
GEMINI_API_KEY=your_google_gemini_api_key

# ==========================================
# Ask VaultMind RAG Settings (Optional)
# ==========================================
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
